# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# eBay Developer Program (developer.ebay.com) — Production keyset, Browse API scope.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Only used by the hosted deployment (see src/middleware.ts) — the local
# desktop app and `npm run dev` never enforce this. Set it on Vercel, not
# here, unless you're testing `npm run build && npm start` locally.
SITE_PASSWORD=
