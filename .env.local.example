# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# eBay Developer Program (developer.ebay.com) — Production keyset, Browse API scope.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Etsy Open API v3 (etsy.com/developers) — keystring from your app's Etsy Developers dashboard.
ETSY_API_KEY=
